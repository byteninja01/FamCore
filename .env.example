# ==============================================================================
# FamCore (Health OS) — Environment Configuration Template
# ==============================================================================

# Application Settings
APP_NAME=FamCore
APP_ENV=development
DEBUG=true
PORT=8000
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000

# Security & Cryptography
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_this_to_a_secure_random_string_min_32_chars_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
# Local SQLite async default for lightweight development:
DATABASE_URL=sqlite+aiosqlite:///./famcore_dev.db
# For PostgreSQL with pgvector (when running local Postgres / Docker):
# DATABASE_URL=postgresql+psycopg://famcore_user:famcore_dev_password@localhost:5432/famcore_db

# Redis Cache (Optional for dev; fallback to in-memory dictionary)
# REDIS_URL=redis://localhost:6379/0

# Object Storage (S3 / MinIO / Local)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/uploads
# For S3 / MinIO:
# STORAGE_PROVIDER=s3
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minio_admin
# S3_SECRET_KEY=minio_secret_key_dev
# S3_BUCKET_NAME=famcore-vault
# S3_REGION=ap-south-1

# External AI Providers (Google Gemini) - Configured via Adapter Interface
PROVIDER_MODE=mock
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Voice Providers (Gnani AI) - Configured via Adapter Interface
# GNANI_API_KEY=
# GNANI_PRISMA_URL=https://api.gnani.ai/v1/stt
# GNANI_TIMBRE_URL=https://api.gnani.ai/v1/tts
